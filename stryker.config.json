{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --experimental-strip-types --test scripts/credit-calculator.test.ts"
  },
  "mutate": ["docs/pages/sdlc-development/examples/credit-calculator.ts"],
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 30000,
  "thresholds": { "high": 85, "low": 75, "break": 80 },
  "ignorePatterns": ["dist", "output", ".cache", ".scratch", ".worktrees", "video", "reports"],
  "reporters": ["clear-text"],
  "cleanTempDir": true
}
